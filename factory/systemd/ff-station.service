[Unit]
Description=feedback factory station service
After=docker.service network-online.target
Wants=network-online.target
[Service]
ExecStartPre=/srv/ff/src/factory/env-refresh.sh
EnvironmentFile=/etc/ff/ff.env
WorkingDirectory=/srv/ff/src/factory
ExecStart=/usr/bin/node /srv/ff/src/factory/server.mjs
Restart=always
RestartSec=3
[Install]
WantedBy=multi-user.target
